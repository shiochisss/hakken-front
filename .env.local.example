# バックエンド（FastAPI）のURL。★ NEXT_PUBLIC_ を付けないこと。
# ブラウザは相対パスしか叩かず、Next.js の Route Handlers がここへ中継する
# （BFF・API設計書 v1.8 A-12）。NEXT_PUBLIC_ を付けるとJSに焼き込まれ、隠す意味が無くなる。
# 本番は Azure Static Web Apps のアプリ設定で与える（このファイルは開発用の雛形）。
API_ORIGIN=http://localhost:8000

# 1 にするとバックエンドなしのモックモード（ログイン不要・ダミーデータで全画面閲覧可）
NEXT_PUBLIC_MOCK=1
